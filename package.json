{
  "name": "@deepwhale-cn/dsh-shot-verify",
  "version": "0.1.0",
  "description": "生成逐页截图清单、核验截图产物（存在/大小/新鲜度），并产出对比画廊页；截图由 agent 或人工完成",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "截图",
    "视觉",
    "上线"
  ],
  "files": [
    "lib",
    "skill",
    "bin",
    "cordis.patch.yml",
    "tests/fixtures",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-shot-verify": "bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-shot-verify.git"
  },
  "homepage": "https://deepwhale.org.cn/plugins.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-shot-verify/issues"
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1"
  }
}